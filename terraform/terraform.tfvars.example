# Copy this file to terraform.tfvars and edit values if needed.
# terraform.tfvars is git-ignored.

aws_region       = "ap-south-1"
project_name     = "cicd-demo"
owner            = "Ashwini Arude"
instance_type    = "t3.small"   # use "c7i-flex.large" if the console shows it as free-tier eligible
root_volume_size = 20

# Tighter security: replace with your public IP, e.g. ["49.36.12.34/32"]
allowed_cidrs = ["0.0.0.0/0"]
