# ---------------------------------------------------------------------------
# Root module: looks up the latest Ubuntu 24.04 AMI, creates an SSH key pair,
# and calls the reusable "jenkins-server" module to provision the EC2 server.
# ---------------------------------------------------------------------------

# Latest official Ubuntu 24.04 LTS (Noble) image published by Canonical
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# SSH key generated by Terraform - the private key is saved locally as a .pem file
resource "tls_private_key" "ssh" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "this" {
  key_name   = "${var.project_name}-key"
  public_key = tls_private_key.ssh.public_key_openssh
}

resource "local_sensitive_file" "private_key" {
  content         = tls_private_key.ssh.private_key_pem
  filename        = "${path.module}/${var.project_name}-key.pem"
  file_permission = "0400"
}

# Reusable module - can be called again with different inputs for another server
module "jenkins_server" {
  source = "./modules/jenkins-server"

  name             = "${var.project_name}-jenkins"
  ami_id           = data.aws_ami.ubuntu.id
  instance_type    = var.instance_type
  key_name         = aws_key_pair.this.key_name
  root_volume_size = var.root_volume_size
  allowed_cidrs    = var.allowed_cidrs
  ingress_ports    = var.ingress_ports
  user_data        = file("${path.module}/scripts/user_data.sh")
}
